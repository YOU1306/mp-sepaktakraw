########################################################################
# Production environment template — copy to .env on the server and fill
# in every blank. NEVER commit the real .env (it is already gitignored).
#
#   cp .env.production.example .env
#   php artisan key:generate --force   # sets APP_KEY below
########################################################################

APP_NAME="MP Sepaktakraw Federation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
# Replace with your real domain once DNS is pointed at the server.
# Placeholder used throughout deploy/ and docs/DEPLOYMENT.md — swap everywhere.
APP_URL=https://mpsepaktakraw.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Local MySQL on the same VPS (see deploy/server-setup.sh)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mp_sepaktakraw
DB_USERNAME=mp_sepaktakraw
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=mp_sepaktakraw

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# SMTP relay (e.g. Brevo: smtp-relay.brevo.com, port 587, your Brevo login + SMTP key)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@mpsepaktakraw.in"
MAIL_FROM_NAME="${APP_NAME}"

# Razorpay — start with TEST keys, switch to LIVE keys only when ready to
# accept real payments (see docs/DEPLOYMENT.md "Going live with payments").
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# First super admin (seeded once via `php artisan db:seed --class=SuperAdminSeeder --force`)
# Change this password immediately after first login.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=superadmin@mpsepaktakraw.in
SUPER_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
