APP_NAME="MP Sepaktakraw Federation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sail defaults — use service names as hostnames inside Docker
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mp_sepaktakraw
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=mp_sepaktakraw

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real SMTP relay (required for registration receipts, invites, notifications)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@mpsepaktakraw.in"
MAIL_FROM_NAME="${APP_NAME}"

# Razorpay — use test keys in local/staging, live keys only in production
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

MSG91_AUTH_KEY=
MSG91_SENDER_ID=MPSTKW

# Path to UIDAI's published Offline-KYC signing certificate (PEM/CER).
# AADHAAR_UIDAI_CERT_PATH=

# First super admin (seeded) — change password immediately after first login
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=superadmin@mpsepaktakraw.test
SUPER_ADMIN_PASSWORD=ChangeMeNow!

VITE_APP_NAME="${APP_NAME}"
